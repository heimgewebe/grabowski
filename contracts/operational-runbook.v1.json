{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operational-runbook.v1",
  "title": "Grabowski Operational Runbook v1 Frontmatter Metadata",
  "description": "Schema for the value of the operational_runbook key in bounded Markdown frontmatter. Grabowski additionally accepts only its documented dependency-free YAML subset and repository-relative Markdown paths under a runbooks directory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "status",
    "title",
    "applies_to",
    "symptoms",
    "evidence_refs",
    "verified_against",
    "does_not_establish"
  ],
  "properties": {
    "contract": {
      "const": "operational-runbook.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,159}$"
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "superseded",
        "draft"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "platforms",
        "components"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9*][a-z0-9._:*+-]{0,95}$"
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9*][a-z0-9._:*+-]{0,95}$"
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9*][a-z0-9._:*+-]{0,95}$"
          }
        }
      }
    },
    "symptoms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9*][a-z0-9._:*+-]{0,95}$"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "verified_against": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "known_bad_paths": {},
    "rollback": {},
    "related_runbooks": {},
    "version_constraints": {},
    "supersedes": {}
  }
}
