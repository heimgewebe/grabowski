{
  "$defs": {
    "contractContradiction": {
      "allOf": [
        {
          "$ref": "#/$defs/signal"
        },
        {
          "properties": {
            "id": {
              "const": "contract_contradiction"
            }
          }
        }
      ]
    },
    "repeatedBlockade": {
      "allOf": [
        {
          "$ref": "#/$defs/signal"
        },
        {
          "properties": {
            "id": {
              "const": "repeated_blockade"
            }
          }
        }
      ]
    },
    "signal": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "details": {
          "type": "object"
        },
        "does_not_establish": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence_quality": {
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "evidence_refs_truncated": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "observed_count": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "recommended_action": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "none",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "clear",
            "observed",
            "indeterminate"
          ]
        }
      },
      "required": [
        "id",
        "status",
        "severity",
        "count",
        "observed_count",
        "evidence_refs",
        "evidence_refs_truncated",
        "evidence_quality",
        "recommended_action",
        "details",
        "does_not_establish"
      ],
      "type": "object"
    },
    "staleAttention": {
      "allOf": [
        {
          "$ref": "#/$defs/signal"
        },
        {
          "properties": {
            "id": {
              "const": "stale_attention"
            }
          }
        }
      ]
    },
    "transitionGap": {
      "allOf": [
        {
          "$ref": "#/$defs/signal"
        },
        {
          "properties": {
            "id": {
              "const": "transition_gap"
            }
          }
        }
      ]
    },
    "uncertainOutcome": {
      "allOf": [
        {
          "$ref": "#/$defs/signal"
        },
        {
          "properties": {
            "id": {
              "const": "uncertain_outcome"
            }
          }
        }
      ]
    }
  },
  "$id": "audit-signal.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of_unix": {
      "minimum": 0,
      "type": "integer"
    },
    "authority": {
      "const": "derived_read_only_projection"
    },
    "does_not_establish": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "findings_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "projection_kind": {
      "const": "audit-signal.v1"
    },
    "projection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "recommended_next_action": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "signals": {
      "items": false,
      "maxItems": 5,
      "minItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/uncertainOutcome"
        },
        {
          "$ref": "#/$defs/contractContradiction"
        },
        {
          "$ref": "#/$defs/transitionGap"
        },
        {
          "$ref": "#/$defs/repeatedBlockade"
        },
        {
          "$ref": "#/$defs/staleAttention"
        }
      ],
      "type": "array"
    },
    "source_binding": {
      "type": "object"
    },
    "source_health": {
      "type": "object"
    },
    "window": {
      "additionalProperties": false,
      "properties": {
        "end_unix": {
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "const": "7d"
        },
        "start_unix": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "label",
        "start_unix",
        "end_unix"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "projection_kind",
    "authority",
    "as_of_unix",
    "window",
    "source_binding",
    "source_health",
    "signals",
    "recommended_next_action",
    "does_not_establish",
    "findings_sha256",
    "projection_sha256"
  ],
  "title": "Grabowski audit signal projection v1",
  "type": "object"
}
