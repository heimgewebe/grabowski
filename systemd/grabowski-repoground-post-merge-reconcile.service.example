[Unit]
Description=Reconcile verified RepoGround post-merge follow-ups
After=grabowski-operator.service

[Service]
Type=oneshot
ExecStart=%h/.local/share/grabowski-mcp/.venv/bin/python -I -m grabowski_repoground_post_merge --reconcile-audit-followups --reconcile-lookback-seconds 25200
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/grabowski
UMask=0077
# Allow up to 900s for verified audit discovery plus 720s for job processing.
# The latter reserves 540s before entering a new 16-slot identity. An overlong
# discovery fails explicitly rather than silently consuming the job reserve.
# The outer timeout leaves 180s margin for finalization and shutdown.
TimeoutStartSec=1800s
