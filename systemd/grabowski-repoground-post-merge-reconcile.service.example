[Unit]
Description=Reconcile verified RepoGround post-merge follow-ups
After=grabowski-operator.service

[Service]
Type=oneshot
ExecStart=%h/.local/share/grabowski-mcp/.venv/bin/python -I -m grabowski_repoground_post_merge --reconcile-audit-followups --reconcile-lookback-seconds 25200
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/grabowski
UMask=0077
# The reconciler keeps a 720s internal pass budget, reserves 540s before
# entering a new 16-slot identity, and persists a round-robin cursor so a slow
# read-only identity cannot starve later merge obligations across timer runs.
# The outer limit leaves additional margin for audit verification and shutdown.
TimeoutStartSec=900s
