[Unit]
Description=Reconcile verified RepoGround post-merge follow-ups
After=grabowski-operator.service

[Service]
Type=oneshot
ExecStart=%h/.local/share/grabowski-mcp/.venv/bin/python -I -m grabowski_repoground_post_merge --reconcile-audit-followups --reconcile-lookback-seconds 25200
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/grabowski
UMask=0077
# Worst case: 16 reusable-slot status reads at 30s each plus a 60s launch.
# Keep additional margin for audit verification and launch ambiguity readback.
TimeoutStartSec=900s
