[Unit]
Description=Grabowski MCP operator
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=alex
Group=alex
WorkingDirectory=/home/alex
ExecStart=/home/alex/.local/share/grabowski-mcp/.venv/bin/python -m grabowski_operator --transport streamable-http --host 127.0.0.1 --port 18181
Restart=on-failure
RestartSec=2
TimeoutStartSec=20
TimeoutStopSec=20
KillMode=mixed
UMask=0077
Environment=HOME=/home/alex
Environment=PATH=/home/alex/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HEIM_NODE_RUNTIME_ENV_DIR=/run/grabowski-node-runtime-env
RuntimeDirectory=grabowski-node-runtime-env
RuntimeDirectoryMode=0700
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/alex/.local/state/grabowski /home/alex/.local/state/bureau /home/alex/repos /home/alex/grabowski-workspace
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
LimitCORE=0
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
