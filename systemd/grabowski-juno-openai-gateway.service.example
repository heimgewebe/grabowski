[Unit]
Description=Grabowski controlled OpenAI-compatible gateway for Juno
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/libexec/grabowski/grabowski_juno_runtime_launcher.py serve
Restart=on-failure
RestartSec=3
TimeoutStartSec=20
TimeoutStopSec=20
KillMode=mixed
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.nix-profile/bin:%h/.local/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
NoNewPrivileges=yes
# The per-user manager needs a private user namespace before mount/device
# sandboxing and capability reductions become available without host privilege.
PrivateUsers=yes
# Inside that private user namespace, drop the namespace-local capability set
# completely; the process retains no capabilities on the host or in the sandbox.
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/share/grabowski-mcp
BindReadOnlyPaths=%h/.local/bin
# The canonical router also checks the Grok auth-file inode identity for state freshness.
# Without the directory identity, even a Codex-only route appears stale.
BindReadOnlyPaths=-%h/.grok
BindReadOnlyPaths=-%h/.nix-profile
BindReadOnlyPaths=-%h/.local/state/nix/profiles
BindReadOnlyPaths=%h/.local/libexec/grabowski/grabowski_juno_openai_gateway.py
BindReadOnlyPaths=%h/.local/libexec/grabowski/grabowski_juno_runtime_launcher.py
BindReadOnlyPaths=%h/.local/state/grabowski/coding-agent-router
BindReadOnlyPaths=%h/.local/state/grabowski/juno-openai-gateway
BindPaths=%h/.codex
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LimitCORE=0
SystemCallArchitectures=native

[Install]
WantedBy=default.target