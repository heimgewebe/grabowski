[Unit]
Description=Run Grabowski tunnel watchdog

[Timer]
OnBootSec=45s
# Calendar scheduling is independent of the oneshot service activation state.
# This keeps a future elapse armed even when a prior watchdog run exits with a
# non-success status or the user manager is reloaded after boot.
OnCalendar=*-*-* *:0/2:00
AccuracySec=5s
# RandomizedDelaySec only decorrelates timer firings across units. Restart
# pacing (exponential backoff with jitter and persisted
# next_restart_not_before) lives in component_watchdog.py; systemd 249 has no
# RestartSteps, so the semantic watchdog carries the backoff.
RandomizedDelaySec=3s
Persistent=true
Unit=grabowski-tunnel-watchdog.service

[Install]
WantedBy=timers.target
