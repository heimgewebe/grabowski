[Unit]
Description=Periodically reconcile persistent Grabowski tasks

[Timer]
# Preserve the normal cadence from the prior run's terminal transition. A slow
# or timed-out oneshot therefore does not make the next normal run immediately
# overdue.
OnUnitInactiveSec=1min
# Independent recovery cadence: after a user-manager reload/reexec the target
# oneshot may have no retained inactive timestamp, which otherwise leaves this
# enabled timer active/elapsed with NextElapse=infinity. The calendar source is
# owned by the timer itself and re-establishes the service observation cycle.
OnCalendar=*-*-* *:0/5:00
AccuracySec=30s
Persistent=true
Unit=grabowski-reconcile-tasks.service

[Install]
WantedBy=timers.target
