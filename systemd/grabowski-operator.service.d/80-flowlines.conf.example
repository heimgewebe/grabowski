[Service]
# Commit-bound non-secret Flowlines configuration. Export remains disabled unless
# an operator explicitly provisions the root-owned local enablement file with
# GRABOWSKI_FLOWLINES_ENABLED=1. The exporter credential remains separate at
# /etc/grabowski/flowlines-headers and is read only by the authorized operator
# MainPID through the privileged broker.
EnvironmentFile=-/etc/grabowski/flowlines-enabled.env
