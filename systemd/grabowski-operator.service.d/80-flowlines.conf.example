[Service]
# Explicit non-secret Flowlines opt-in. The exporter credential remains
# root-owned at /etc/grabowski/flowlines-headers and is read by the operator
# MainPID through the existing privileged broker. The trace endpoint is pinned
# in grabowski_flowlines.py; ambient OTLP endpoint/header overrides stay unset.
Environment=GRABOWSKI_FLOWLINES_ENABLED=1
